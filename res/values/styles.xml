<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:colorPrimaryDark">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlNormal">@color/on_surface_variant</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/outline</item>
        <item name="android:textColorHighlight">@color/primary_container</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
